# Адрес развёрнутого веб-приложения Apps Script
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec

# Та же строка, что в переменной SECRET внутри Submit.gs.
# Только латинские буквы и цифры: $ здесь означает подстановку другой
# переменной, и значение обрежется по первому $. Сгенерировать можно так:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url').replace(/[^A-Za-z0-9]/g,''))"
APPS_SCRIPT_SECRET=замените-на-свою-длинную-строку
